    },
    {
      "id": "kimi-k3",
      "match": "kimi-k3",
      "charsPerToken": 3,
      "contextWindow": 1048576,
      "maxImages": null,
      "note": "The K3 models of the Kimi platform. The ids of Kimi Code (k3, k3.1-pro) do not match: there the window is that of the plan, and the provider config gives it. Text: \"1 Token is roughly equivalent to 3-4 English characters\". Images: \"no limit on the number of images\", but a request body of at most 100M.",
      "sources": [
