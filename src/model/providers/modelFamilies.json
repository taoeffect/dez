    },
    {
      "id": "gemini-2",
      "match": "gemini-2",
      "charsPerToken": 4,
      "imageTokens": { "rule": "fixed", "tokens": 2304 },
      "contextWindow": 1048576,
      "maxImages": 3600,
      "note": "Image: a Gemini 2 model with no media resolution in the request counts \"256 + Pan & Scan (~2048)\" tokens. Dez sends no media resolution.",
      "sources": [
        "https://aistudio.google.com/docs/media-resolution.md",
        "https://aistudio.google.com/docs/models/gemini-2.5-flash.md",
        "https://aistudio.google.com/docs/image-understanding.md",
