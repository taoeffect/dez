{
  "families": [
    {
      "id": "claude-1m",
      "match": "claude-(fable|mythos)|claude-(opus|sonnet)-(4[.-][6-9]|5)(?!\\d)|claude-haiku-5[.-]5(?!\\d)",
      "charsPerToken": 2.5,
      "imageTokens": { "rule": "patches", "patchPx": 28, "maxLongSidePx": 2576, "maxPatches": 4784 },
      "contextWindow": 1000000,
      "maxImages": 600,
      "manyImages": { "over": 20, "maxSidePx": 3000 },
      "note": "The models that the docs name with a 1M window: Fable and Mythos 5 to 5.2, Opus 4.6 to 5.5, Sonnet 4.6 to 5.5, and Haiku 5.5. Text: 1M tokens are about 2.5M characters with the tokenizer of Opus 4.7 and later; an older model has about 3.5 characters per token. Image: one token for each square of 28 px after a scale down to a long side of 2,576 px, at most 4,784 tokens (Claude 4.7 and later; an older model counts at most 1,568).",
      "sources": [
        "https://platform.claude.com/docs/en/models/overview.md",
        "https://platform.claude.com/docs/en/build-with-claude/context-windows.md",
        "https://platform.claude.com/docs/en/build-with-claude/vision.md"
      ],
      "checked": "2026-11-14"
    },
    {
      "id": "claude",
      "match": "claude",
      "charsPerToken": 2.5,
      "imageTokens": { "rule": "patches", "patchPx": 28, "maxLongSidePx": 2576, "maxPatches": 4784 },
      "contextWindow": 200000,
      "maxImages": 100,
      "manyImages": { "over": 20, "maxSidePx": 3000 },
      "note": "Every Claude model that `claude-1m` does not name has a 200k window, and takes 100 images in one request. The text and image numbers are those of `claude-1m`, which count the most.",
      "sources": [
        "https://platform.claude.com/docs/en/models/overview.md",
        "https://platform.claude.com/docs/en/build-with-claude/context-windows.md",
        "https://platform.claude.com/docs/en/build-with-claude/vision.md"
      ],
      "checked": "2026-11-14"
    },
    {
      "id": "gpt-oss",
      "match": "gpt-oss",
      "contextWindow": 131072,
      "note": "The open models of OpenAI (gpt-oss-120b, gpt-oss-20b). They read no images.",
      "sources": [
        "https://developers.openai.com/api/docs/models/gpt-oss-120b.md",
        "https://developers.openai.com/api/docs/models/gpt-oss-20b.md"
      ],
      "checked": "2026-11-14"
    },
    {
      "id": "openai-gpt-3.5",
      "match": "gpt-3[.-]?5",
