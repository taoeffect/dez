    {
      "id": "deepseek-v4",
      "match": "deepseek-(v4|flash)",
      "charsPerToken": 3.3,
      "imageTokens": { "rule": "fixed", "tokens": 1024 },
      "contextWindow": 1000000,
      "maxImages": 600,
      "manyImages": { "over": 14, "maxSidePx": 4096 },
      "note": "The models of the DeepSeek API (deepseek-flash, deepseek-v4-pro, and the V4 models by name). An older DeepSeek model, such as a local copy of R1, has no entry. Text: \"1 English character ≈ 0.3 token\". Image: \"an upper bound of 1024 tokens per image\"; a side of at most 8,192 px, and of 4,096 px \"when a request contains 15 or more images\".",
      "sources": [
