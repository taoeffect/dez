{
  "name": "dez",
  "private": true,
  "version": "0.14.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "clean:rust": "node scripts/clean-rust.js",
    "build:linux:appimage": "npm run clean:rust && NO_STRIP=1 node scripts/build-linux-appimage.js",
    "build:macos:dmg": "npm run clean:rust && node scripts/build-macos-icon.js && tauri build --target aarch64-apple-darwin --bundles dmg",
    "build:macos:app": "npm run clean:rust && node scripts/build-macos-icon.js && tauri build --target aarch64-apple-darwin --bundles app",
    "build:desktop": "npm run clean:rust && node scripts/build-desktop.js",
    "test": "vitest run",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "typecheck:e2e": "tsc -p tsconfig.e2e.json --noEmit",
    "test:watch": "vitest",
    "bump-version": "node scripts/bump-version.js",
    "preview": "vite preview",
    "tauri": "npm run clean:rust && tauri"
  },
  "dependencies": {
    "@codemirror/commands": "6.10.3",
    "@codemirror/lang-markdown": "6.5.0",
    "@codemirror/language": "6.12.3",
    "@codemirror/search": "6.6.0",
    "@codemirror/state": "6.6.0",
    "@codemirror/view": "6.41.1",
    "@sbp/okturtles.eventqueue": "1.2.1",
    "@sbp/okturtles.events": "1.0.1",
    "@sbp/sbp": "2.4.1",
    "@tauri-apps/api": "2",
    "@tauri-apps/plugin-dialog": "2.7.0",
    "@tauri-apps/plugin-fs": "2.5.0",
    "@tauri-apps/plugin-opener": "2",
    "@tauri-apps/plugin-store": "2.4.2",
    "codemirror": "6.0.2",
    "pinia": "3.0.4",
    "shiki": "4.0.2",
    "turtledash": "1.0.3",
    "vue": "3.5.13",
    "w3c-keyname": "2.2.8",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2",
    "@vitejs/plugin-vue": "5.2.1",
    "typescript": "~5.6.2",
    "vite": "6.4.1",
    "vitest": "4.1.5",
    "vue-tsc": "2.1.10",
    "webdriverio": "9.29.1"
  }
}
