{
  "compilerOptions": {
    "target": "ES2023",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "preserve",
    /* dez-media is JavaScript with JSDoc types (// @ts-check) */
    "allowJs": true,
    /* The built-in apps import dez-media, skia-canvas, and chart.js by
       their names in the import map of the Deno runs
       (src-tauri/libs/import_map.json). Chart.js ships no types there, so
       its types come from its JavaScript */
    "paths": {
      "dez-media": ["./src-tauri/libs/dez-media/mod.js"],
      "dez-media/canvas": ["./src-tauri/libs/dez-media/canvas.js"],
      "dez-media/frames": ["./src-tauri/libs/dez-media/frames.js"],
      "skia-canvas": ["./src-tauri/libs/skia-canvas/lib/index.d.ts"],
      "chart.js": ["./src-tauri/libs/chart.js/dist/chart.js"]
    },

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.d.ts",
    "src/**/*.tsx",
    "src/**/*.vue",
    "src-tauri/libs/dez-media/**/*.js",
    "src-tauri/builtin-apps/**/*.ts",
    "tests/dez-media/**/*.ts",
    "tests/builtin-apps/**/*.ts"
  ],
  "references": [{ "path": "./tsconfig.node.json" }]
}
