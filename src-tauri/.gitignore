# Generated by Cargo
# will have compiled files and executables
/target/

# Generated by Tauri
# will have schema files for capabilities auto-completion
/gen/schemas

# Generated by scripts/build-macos-icon.js from icons/Dez.icon
/icons/Assets.car

# The programs that Dez ships (ffmpeg, ffprobe, Deno) are not in Git:
# scripts/fetch-programs.js downloads the programs of a build target, and
# takes only the files that binaries/manifest.json pins (URL, size, and
# SHA-256). The manifest and the license files of the folder are tracked,
# so no tracked file of it may have a name that starts with `dez-`.
/binaries/dez-*

# The download folders of scripts/fetch-programs.js, and of
# scripts/update-ffmpeg.js and scripts/update-deno.js. A run that was
# killed leaves its folder.
/binaries/.fetch-*/
/binaries/.update-*/

# The download folder of scripts/update-fonts.js. A run that was killed
# leaves it, with fonts that the Git LFS rule does not cover.
/.fonts-update-*/
