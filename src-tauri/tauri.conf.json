{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Dez",
  "version": "0.60.0",
  "identifier": "com.taoeffect.dez",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Dez",
        "width": 900,
        "height": 700,
        "minWidth": 600,
        "minHeight": 400,
        "visible": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": [
            "/**"
          ],
          "requireLiteralLeadingDot": false
        }
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/dez-ffmpeg",
      "binaries/dez-ffprobe",
      "binaries/dez-deno"
    ],
    "resources": {
      "fonts/": "fonts/",
      "libs/": "libs/",
      "builtin-apps/": "builtin-apps/",
      "binaries/NOTICE.md": "ffmpeg/NOTICE.md",
      "binaries/LICENSES.txt": "ffmpeg/LICENSES.txt",
      "binaries/deno/NOTICE.md": "deno/NOTICE.md",
      "binaries/deno/LICENSES.txt": "deno/LICENSES.txt"
    },
    "macOS": {
      "entitlements": "./Entitlements.plist",
      "files": {
        "Resources/Assets.car": "icons/Assets.car"
      }
    },
    "linux": {
      "appimage": {
        "bundleMediaFramework": true
      }
    }
  }
}
